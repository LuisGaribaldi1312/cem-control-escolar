# Copia este archivo a ".env" y llena tus propios valores. Nunca subas el ".env" real a GitHub.

# Puerto en el que corre el servidor (Render/Railway lo asignan solos, puedes dejarlo)
PORT=3000

# URL pública final de tu sitio (usada para armar el enlace dentro del código QR)
# Ejemplo una vez desplegado: https://cem-escuela.onrender.com
APP_BASE_URL=http://localhost:3000

# Frase secreta para firmar las sesiones del panel administrativo (pon algo largo y único)
JWT_SECRET=cambia-esto-por-una-frase-larga-y-unica

# Credenciales iniciales del administrador (solo se usan la PRIMERA vez que arranca el servidor)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=12345

# --- Correo electrónico (elige un proveedor: SendGrid, Resend, Gmail, etc.) ---
# Ejemplo con SendGrid SMTP:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=tu_api_key_de_sendgrid
# Ejemplo con Resend SMTP:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=tu_api_key_de_resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Centro Educativo CEM <no-responder@tu-dominio.com>"
